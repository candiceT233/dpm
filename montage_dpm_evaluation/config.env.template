# config.env.template — copy to config.env and fill in for your cluster
# DO NOT commit config.env (it contains cluster-specific paths)

CLUSTER_NAME="TODO"            # e.g., deception, tahoma, constance
PARTITION="TODO"               # Slurm partition with target nodes
ACCOUNT="TODO"                 # Slurm account to charge

# Node configuration
NODES=4                        # Starting node count (scale: 4, 8, 16)
CORES_PER_NODE=TODO            # Physical CPU cores per node (e.g., 64)
MEM_PER_NODE_GB=TODO           # Total RAM per node in GB (e.g., 384)

# Storage paths (must be accessible from compute nodes)
LOCAL_SSD_PATH="TODO"          # Node-local SSD mount, e.g., /local/scratch
BEEGFS_PATH="TODO"             # Shared parallel FS path, e.g., /rcfs/projects/...
TMPFS_PATH="/dev/shm"          # TMPFS (usually /dev/shm)

# Montage configuration
MONTAGE_BIN="TODO"             # Path to compiled Montage binaries, e.g., /path/to/Montage/bin
MONTAGE_DATA="TODO"            # Path to downloaded FITS data directory

# Software
PYTHON_ENV="TODO"              # Path to conda env or virtualenv
DARSHAN_LIB=""                 # Optional: path to libdarshan.so for I/O tracing

# DPM profiling (optional, if IOR profiles already exist)
DPM_PROFILE_DIR=""             # Leave empty if profiles not yet collected
