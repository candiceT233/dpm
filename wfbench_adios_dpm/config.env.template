# config.env.template — copy to config.env and fill in for your cluster
# DO NOT commit config.env (it contains cluster-specific paths)

CLUSTER_NAME="TODO"            # e.g., deception, tahoma, constance, chicoma
PARTITION="slurm"              # Partition with dcXXX nodes
NODES=4                        # Starting node count; scale to 8, 16, 32 for Phase 3
MAX_NODES=32                   # Upper bound for node-scaling experiments
CORES_PER_NODE=TODO            # Physical CPU cores per node
MEM_PER_NODE_GB=TODO           # Total RAM per node in GB (e.g., 384)

# Storage paths (must be accessible from compute nodes)
LOCAL_SSD_PATH="TODO"          # Node-local SSD mount, e.g., /local/scratch or /nvme
BEEGFS_PATH="TODO"             # Shared BeeGFS/Lustre path, e.g., /rcfs/projects/myproject
TMPFS_PATH="/dev/shm"          # TMPFS (usually /dev/shm, no change needed)

# Software
ADIOS2_MODULE="TODO"           # Module name, e.g., adios2/2.9.1-openmpi4
PYTHON_ENV="TODO"              # Path to conda env or virtualenv, e.g., /path/to/.venv

# Optional: DPM profile directory (if IOR profiles already exist for this cluster)
DPM_PROFILE_DIR=""             # Leave empty if profiles not yet collected
